+# `CLOCK_MONOTONIC`, the time base Chrome's `performance.now()` is derived from.
+[target.'cfg(unix)'.dependencies]
+libc = "0.2.189"
+
+# `QueryPerformanceCounter`, the time base Chrome's `performance.now()` is derived from on
+# Windows.
+[target.'cfg(windows)'.dependencies]
+windows-sys = { version = "0.61", features = ["Win32_System_Performance"] }
